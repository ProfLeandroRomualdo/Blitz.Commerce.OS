# Copy to deploy/gcp/.env.deploy (gitignored). Never commit real secrets.
GCP_PROJECT=your-gcp-project-id
GCP_REGION=southamerica-east1
ARTIFACT_REPO=blitz-commerce
CLOUD_RUN_SERVICE=blitz-commerce-staging
CLOUD_SQL_INSTANCE=blitz-commerce-pg
CLOUD_SQL_DB=blitz
CLOUD_SQL_USER=blitzapp
DATABASE_URL_SECRET=blitz-commerce-db-url
API_KEY_SECRET=blitz-commerce-demo-api-key
PUBLIC_BASE_URL=https://YOUR_CLOUD_RUN_URL  # update after deployment
